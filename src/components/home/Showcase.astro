---
import { buttonVariants } from '@/components/ui/button';

const stats = [
  { value: 'v11.0', label: 'e-Fatura DFE spec' },
  { value: '9', label: 'document types' },
  { value: 'XAdES-BES', label: 'XML signing' },
  { value: '3', label: 'framework adapters' },
];

const pipeline = [
  {
    step: 'Build',
    desc: 'Fluent invoice builder with lines, taxes, totals.',
    path: 'M12 20h9 M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z',
  },
  {
    step: 'Validate',
    desc: 'Zod schemas plus fiscal rules.',
    path: 'M9 12l2 2 4-4 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  },
  {
    step: 'XML v11',
    desc: 'Official DFE mapping, XSD-checked.',
    path: 'M16 18l6-6-6-6 M8 6l-6 6 6 6',
  },
  {
    step: 'Sign',
    desc: 'XAdES-BES with your certificate.',
    path: 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z M9 12l2 2 4-4',
  },
  {
    step: 'Package',
    desc: 'Deflate ZIP from IUD and XML.',
    path: 'M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.3 7L12 12l8.7-5',
  },
  {
    step: 'Submit',
    desc: 'Middleware and DNRE readiness.',
    path: 'M22 2 11 13 M22 2l-7 20-4-9-9-4 20-7z',
  },
];

const features = [
  {
    title: 'Official DFE XML v11',
    desc: 'Compact XML from the official v11 document-element mapping, validated against the bundled e-Fatura XSD set.',
    href: '/05-xml-v11',
    path: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 13l2 2-2 2 M15 13l-2 2 2 2',
  },
  {
    title: 'XAdES-BES signing',
    desc: 'Certificate-backed XML signatures with ICP-CV certificate validation before signing.',
    href: '/03-quick-start',
    path: 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z M9 12l2 2 4-4',
  },
  {
    title: 'Zod validation',
    desc: 'Domain value objects and HTTP payloads validated at one boundary.',
    href: '/06-validation-zod',
    path: 'M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
  },
  {
    title: 'ZIP packaging',
    desc: 'Deflate ZIP payloads from IUD and signed XML, ready for middleware transport.',
    href: '/07-packaging',
    path: 'M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.3 7L12 12l8.7-5 M12 22V12',
  },
  {
    title: 'DFA PDF and QR',
    desc: 'Render fiscal PDFs with QR codes and contingency notices.',
    href: '/03-quick-start',
    path: 'M3 7V5a2 2 0 0 1 2-2h2 M17 3h2a2 2 0 0 1 2 2v2 M21 17v2a2 2 0 0 1-2 2h-2 M7 21H5a2 2 0 0 1-2-2v-2 M7 8h4v4H7z M14 8h3 M14 12h3 M7 16h10',
  },
  {
    title: 'Sequence stores',
    desc: 'In-memory, file, and Knex-backed identifier sequences.',
    href: '/02-configuration',
    path: 'M12 8c4.4 0 8-1.3 8-3s-3.6-3-8-3-8 1.3-8 3 3.6 3 8 3z M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5 M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  },
];

const docTypes = [
  'Electronic Invoice',
  'Invoice-Receipt',
  'Sales Receipt',
  'Receipt',
  'Credit Note',
  'Debit Note',
  'Transport',
  'Return Note',
  'Launch Note',
];

const adapters = [
  { name: 'Express', module: '@akira-io/efatura/express', call: 'efaturaRoutes(efatura)' },
  { name: 'Fastify', module: '@akira-io/efatura/fastify', call: 'efaturaFastifyPlugin' },
  { name: 'Nest', module: '@akira-io/efatura/nest', call: 'EfaturaModule.forRoot()' },
];

const adapterCode = (a: { module: string; call: string }) =>
  [
    `<span class="text-[#c084fc]">import</span> ... <span class="text-[#c084fc]">from</span>`,
    `  <span class="text-[var(--code-string)]">'${a.module}'</span>`,
    ``,
    `<span class="text-primary">${a.call}</span>`,
  ].join('\n');
---

<section class="mx-auto max-w-6xl px-6 pb-16">
  <div class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border lg:grid-cols-4">
    {
      stats.map((s) => (
        <div class="bg-card px-6 py-7 text-center">
          <div class="text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl">{s.value}</div>
          <div class="mt-1 text-sm text-muted-foreground">{s.label}</div>
        </div>
      ))
    }
  </div>
</section>

<section class="mx-auto max-w-6xl px-6 py-12">
  <div class="mb-10 text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">From invoice to fiscal authority</h2>
    <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
      One pipeline, six stages. Each stage owns a contract you can swap.
    </p>
  </div>
  <div class="relative grid gap-x-6 gap-y-5 sm:grid-cols-2 lg:grid-cols-6">
    <div class="pointer-events-none absolute inset-x-10 top-9 hidden h-0.5 bg-gradient-to-r from-primary/0 via-primary/40 to-primary/0 lg:block"></div>
    {
      pipeline.map((stage, i) => (
        <div class="group relative">
          <div class="relative z-10 mx-auto flex size-[4.5rem] items-center justify-center">
            <div class="absolute inset-0 rounded-2xl border border-border bg-card shadow-sm transition-all group-hover:-translate-y-0.5 group-hover:border-primary/60 group-hover:shadow-lg group-hover:shadow-primary/10" />
            <svg
              class="relative text-primary"
              viewBox="0 0 24 24"
              width="26"
              height="26"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={stage.path} />
            </svg>
            <span class="absolute -right-1.5 -top-1.5 z-10 flex size-5 items-center justify-center rounded-full border border-primary/40 bg-background font-mono text-[10px] font-bold text-primary">
              {i + 1}
            </span>
          </div>
          {i < pipeline.length - 1 && (
            <svg
              class="absolute -right-3.5 top-7 z-10 hidden text-primary/40 lg:block"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 18l6-6-6-6" />
            </svg>
          )}
          <div class="mt-4 text-center">
            <div class="font-semibold">{stage.step}</div>
            <div class="mt-1 text-sm text-muted-foreground">{stage.desc}</div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<section class="mx-auto max-w-6xl px-6 py-12">
  <div class="mb-10">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Everything the spec asks for</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      Official artifacts, signing, packaging, and validation, behind a clean facade.
    </p>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((card) => (
        <a
          href={card.href}
          class="group flex flex-col rounded-xl border border-border bg-card/60 p-6 backdrop-blur transition-all hover:-translate-y-0.5 hover:border-primary/50 hover:bg-card"
        >
          <span class="inline-flex size-11 items-center justify-center rounded-lg border border-border bg-accent text-accent-foreground transition-colors group-hover:border-primary/40">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d={card.path} />
            </svg>
          </span>
          <span class="mt-4 text-lg font-semibold group-hover:text-primary">{card.title}</span>
          <span class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{card.desc}</span>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary opacity-0 transition-opacity group-hover:opacity-100">
            Read more
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))
    }
  </div>
</section>

<section class="mx-auto max-w-6xl px-6 py-12">
  <div class="rounded-2xl border border-border bg-card/40 p-8 backdrop-blur sm:p-10">
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">All nine DFE document types</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      Every official e-Fatura v11.0 document code, validated and XSD-tested.
    </p>
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        docTypes.map((t, i) => (
          <div class="group flex items-center gap-3 rounded-xl border border-border bg-background/60 p-3.5 transition-all hover:-translate-y-0.5 hover:border-primary/50">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-border bg-accent font-mono text-xs font-bold text-accent-foreground transition-colors group-hover:border-primary/40">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="font-medium group-hover:text-primary">{t}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-6 py-12">
  <div class="mb-10">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Bring your framework</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      The same HTTP routes, wired into Express, Fastify, or Nest. Mount and go.
    </p>
  </div>
  <div class="grid gap-4 sm:grid-cols-3">
    {
      adapters.map((a) => (
        <a href="/08-adapters" class="group rounded-xl border border-border bg-card/60 p-5 backdrop-blur transition-all hover:-translate-y-0.5 hover:border-primary/50">
          <div class="font-semibold group-hover:text-primary">{a.name}</div>
          <pre class="mt-3 overflow-x-auto rounded-lg border border-border bg-background p-3 font-mono text-xs leading-relaxed"><code set:html={adapterCode(a)} /></pre>
        </a>
      ))
    }
  </div>
</section>

<section class="mx-auto max-w-6xl px-6 py-16">
  <div class="relative overflow-hidden rounded-2xl border border-border bg-card/50 px-8 py-14 text-center backdrop-blur sm:px-12">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_70%_at_50%_0%,color-mix(in_oklab,var(--primary)_22%,transparent),transparent)]"></div>
    <h2 class="mx-auto max-w-2xl text-3xl font-extrabold tracking-tight sm:text-4xl">
      Ship compliant fiscal documents
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-muted-foreground">
      Install the package, wire your config, and emit your first e-Fatura invoice in minutes.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/01-installation" class={buttonVariants({ size: 'lg' })}>Install</a>
      <a href="/03-quick-start" class={buttonVariants({ variant: 'outline', size: 'lg' })}>Quick start</a>
    </div>
  </div>
</section>
