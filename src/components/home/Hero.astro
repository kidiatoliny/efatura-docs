---
import { buttonVariants } from '@/components/ui/button';

interface Props {
  repoUrl: string;
  npmUrl: string;
}

const { repoUrl, npmUrl } = Astro.props;

const p = (s: string) => `<span class="text-primary">${s}</span>`;
const k = (s: string) => `<span class="text-[#c084fc]">${s}</span>`;
const str = (s: string) => `<span class="text-[var(--code-string)]">${s}</span>`;
const dim = (s: string) => `<span class="text-muted-foreground">${s}</span>`;

const heroCode = [
  `${k('import')} {`,
  `  createEfatura,`,
  `  DocumentType,`,
  `} ${k('from')} ${str("'@akira-io/efatura'")}`,
  ``,
  `${k('const')} efatura = ${p('createEfatura')}(config)`,
  ``,
  `${k('const')} invoice = efatura`,
  `  .${p('invoice')}()`,
  `  .${p('type')}(DocumentType.ElectronicInvoice)`,
  `  .${p('issueDate')}(${str("'2026-02-08'")})`,
  `  .${p('receiver')}({ taxId: { countryCode: ${str("'CV'")} } })`,
  `  .${p('line')}(item)`,
  `  .${p('totals')}(totals)`,
  `  .${p('validate')}()`,
  ``,
  dim('// DFE XML v11, sign, package, submit'),
].join('\n');
---

<section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pb-16 pt-20 lg:grid-cols-[1.05fr_0.95fr] lg:pt-28">
  <div class="min-w-0 text-center lg:text-left">
    <a
      href={npmUrl}
      class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1 text-xs font-medium text-muted-foreground backdrop-blur transition-colors hover:border-primary/50 hover:text-foreground"
    >
      <span class="size-1.5 rounded-full bg-primary"></span>
      @akira-io/efatura · public beta
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </a>

    <h1
      class="mx-auto mt-6 max-w-2xl text-balance bg-gradient-to-br from-foreground via-foreground to-primary bg-clip-text text-4xl font-extrabold leading-[1.06] tracking-tight text-transparent sm:text-5xl lg:mx-0 lg:text-6xl"
    >
      Validated, signed, submittable e-Fatura for Node.js
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-muted-foreground lg:mx-0">
      A typed toolkit for Cabo Verde fiscal compliance. Turn an invoice into official v11 DFE XML,
      sign it with XAdES-BES, package the ZIP, and submit to DNRE, all from Express, Fastify, or
      Nest.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
      <a href="/03-quick-start" class={buttonVariants({ size: 'lg' })}>Get started</a>
      <a href={repoUrl} class={buttonVariants({ variant: 'outline', size: 'lg' })}>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
        View source
      </a>
    </div>

    <button
      id="install-pill"
      data-cmd="bun add @akira-io/efatura"
      class="group mt-5 inline-flex max-w-full items-center gap-3 overflow-x-auto rounded-lg border border-border bg-card/70 px-4 py-2.5 font-mono text-xs backdrop-blur transition-colors hover:border-primary/50 sm:text-sm"
    >
      <span class="text-primary">$</span>
      <span class="text-foreground">bun add @akira-io/efatura</span>
      <span data-copy-icon class="text-muted-foreground transition-colors group-hover:text-foreground">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      </span>
      <span data-copy-done class="hidden text-primary">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </span>
    </button>
  </div>

  <div class="relative min-w-0">
    <div class="pointer-events-none absolute -inset-4 -z-10 rounded-2xl bg-[radial-gradient(60%_60%_at_50%_30%,color-mix(in_oklab,var(--primary)_22%,transparent),transparent)] blur-2xl"></div>
    <div class="overflow-hidden rounded-xl border border-border bg-card/80 shadow-2xl shadow-primary/10 backdrop-blur">
      <div class="flex items-center gap-2 border-b border-border px-4 py-3">
        <span class="size-3 rounded-full bg-muted-foreground/30"></span>
        <span class="size-3 rounded-full bg-muted-foreground/30"></span>
        <span class="size-3 rounded-full bg-muted-foreground/30"></span>
        <span class="ml-2 font-mono text-xs text-muted-foreground">invoice.ts</span>
      </div>
      <pre class="overflow-x-auto p-5 font-mono text-[13.5px] leading-relaxed"><code set:html={heroCode} /></pre>
    </div>
  </div>
</section>

<script is:inline>
  const pill = document.getElementById('install-pill');
  if (pill) {
    pill.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pill.dataset.cmd);
        pill.querySelector('[data-copy-icon]').classList.add('hidden');
        pill.querySelector('[data-copy-done]').classList.remove('hidden');
        setTimeout(() => {
          pill.querySelector('[data-copy-done]').classList.add('hidden');
          pill.querySelector('[data-copy-icon]').classList.remove('hidden');
        }, 1600);
      } catch (error) {
        void error;
      }
    });
  }
</script>
