---
import type { NavGroup } from '@/lib/nav';
import SidebarNavItems from '@/components/SidebarNavItems.astro';

interface Props {
  nav: NavGroup[];
  currentSlug: string;
}

const { nav, currentSlug } = Astro.props;
---

<aside
  class="sticky top-16 hidden h-[calc(100vh-4rem)] w-64 shrink-0 overflow-y-auto bg-sidebar px-4 py-6 lg:block"
>
  <nav class="flex flex-col gap-6">
    {
      nav.map((group) => (
        <div>
          <p class="mb-2 px-2 text-xs font-bold uppercase tracking-wider text-foreground">
            {group.label}
          </p>
          <SidebarNavItems items={group.items} currentSlug={currentSlug} />
        </div>
      ))
    }
  </nav>
</aside>
