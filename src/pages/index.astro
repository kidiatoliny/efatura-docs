---
import '@/styles/globals.css';
import { getCollection } from 'astro:content';
import { buildNav } from '@/lib/nav';
import Header from '@/components/Header.astro';
import SeoHead from '@/components/SeoHead.astro';
import Hero from '@/components/home/Hero.astro';
import Showcase from '@/components/home/Showcase.astro';

const docs = await getCollection('docs');
const nav = buildNav(docs);

const siteUrl = Astro.site?.href;
const repoUrl = 'https://github.com/akira-io/node-efatura';
const npmUrl = 'https://www.npmjs.com/package/@akira-io/efatura';

const homeTitle = 'efatura - the Cabo Verde e-Fatura engine for Node.js';
const homeDescription =
  'efatura is a framework-agnostic Node.js engine for Cabo Verde e-Fatura fiscal documents. Build and validate DFE documents, generate official v11 XML, sign with XAdES-BES, package ZIP payloads, and check DNRE fiscal readiness with a contracts-only core and Express, Fastify, and Nest adapters.';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'efatura docs',
  url: siteUrl,
  description: homeDescription,
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: 'akira-io', url: 'https://github.com/akira-io' },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '@akira-io/efatura',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js',
  description: homeDescription,
  url: siteUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'akira-io', url: 'https://github.com/akira-io' },
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <SeoHead title={homeTitle} description={homeDescription} type="website" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <Header nav={nav} />

    <main class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,color-mix(in_oklab,var(--border)_55%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_oklab,var(--border)_55%,transparent)_1px,transparent_1px)] bg-[size:54px_54px] [mask-image:radial-gradient(ellipse_80%_55%_at_50%_0%,#000_55%,transparent_100%)]"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[640px] bg-[radial-gradient(60%_60%_at_72%_-12%,color-mix(in_oklab,var(--primary)_24%,transparent),transparent)]"
      >
      </div>

      <Hero repoUrl={repoUrl} npmUrl={npmUrl} />
      <Showcase />
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-muted-foreground sm:flex-row">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-foreground">efatura</span>
          <span>·</span>
          <span>Built by akira-io</span>
        </div>
        <div class="flex items-center gap-5">
          <a href="/01-installation" class="transition-colors hover:text-foreground">Docs</a>
          <a href={repoUrl} class="transition-colors hover:text-foreground">GitHub</a>
          <a href={npmUrl} class="transition-colors hover:text-foreground">npm</a>
          <a href="/llms.txt" class="transition-colors hover:text-foreground">llms.txt</a>
        </div>
      </div>
    </footer>
  </body>
</html>
