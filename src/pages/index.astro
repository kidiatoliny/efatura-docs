---
import '@/styles/globals.css';
import { getCollection } from 'astro:content';
import { buildNav } from '@/lib/nav';
import { buttonVariants } from '@/components/ui/button';
import Header from '@/components/Header.astro';
import SeoHead from '@/components/SeoHead.astro';

const docs = await getCollection('docs');
const nav = buildNav(docs);

const siteUrl = Astro.site?.href;
const homeTitle = 'efatura - the Cabo Verde e-Fatura engine for Node.js';
const homeDescription =
  'efatura is a framework-agnostic Node.js engine for Cabo Verde e-Fatura fiscal documents. Build and validate DFE documents, generate official v11 XML, sign with XAdES-BES, package ZIP payloads, and check DNRE fiscal readiness with a contracts-only core and Express, Fastify, and Nest adapters.';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'efatura docs',
  url: siteUrl,
  description: homeDescription,
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: 'akira-io', url: 'https://github.com/akira-io' },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '@akira-io/efatura',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js',
  description: homeDescription,
  url: siteUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'akira-io', url: 'https://github.com/akira-io' },
};

const cards = [
  {
    title: 'Installation',
    description: 'Package install, runtime requirements, and framework adapters.',
    href: '/01-installation',
    path: 'M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z',
  },
  {
    title: 'Quick start',
    description: 'Build and validate your first e-Fatura invoice.',
    href: '/03-quick-start',
    path: 'M5 12h14M13 5l7 7-7 7',
  },
  {
    title: 'Configuration',
    description: 'Every createEfatura option, its default, and what it unlocks.',
    href: '/02-configuration',
    path: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z',
  },
  {
    title: 'XML v11',
    description: 'The DFE XML envelope, document elements, and XSD validation boundary.',
    href: '/05-xml-v11',
    path: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z',
  },
  {
    title: 'Adapters',
    description: 'Express, Fastify, and Nest adapters over the shared HTTP routes.',
    href: '/08-adapters',
    path: 'M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z',
  },
  {
    title: 'Architecture',
    description: 'The clean layers, contracts-only core, and dependency direction.',
    href: '/10-architecture',
    path: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <SeoHead title={homeTitle} description={homeDescription} type="website" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(softwareSchema)}
    />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <Header nav={nav} />
    <main class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-[480px] bg-[radial-gradient(60%_60%_at_78%_-10%,color-mix(in_oklab,var(--primary)_18%,transparent),transparent)]"
      >
      </div>

      <section class="relative mx-auto max-w-5xl px-6 pb-10 pt-24 text-center sm:pt-32">
        <h1
          class="mx-auto max-w-3xl bg-gradient-to-br from-foreground via-foreground to-primary bg-clip-text text-5xl font-extrabold tracking-tight text-transparent sm:text-6xl"
        >
          The Cabo Verde e-Fatura engine for Node.js
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground">
          Framework-agnostic. The core knows only contracts and value objects, then builds DFE
          documents, generates official v11 XML, signs with XAdES-BES, packages ZIP payloads, and
          checks DNRE fiscal readiness.
        </p>
        <div class="mt-8 flex items-center justify-center gap-3">
          <a href="/03-quick-start" class={buttonVariants({ size: 'lg' })}>Get started</a>
          <a
            href="https://github.com/akira-io/node-efatura"
            class={buttonVariants({ variant: 'outline', size: 'lg' })}
          >
            View source
          </a>
        </div>
      </section>

      <section class="relative mx-auto max-w-5xl px-6 pb-24">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            cards.map((card) => (
              <a
                href={card.href}
                class="group flex flex-col rounded-xl border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-primary/50"
              >
                <span class="inline-flex size-10 items-center justify-center rounded-lg border border-border bg-accent text-accent-foreground">
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={card.path} />
                  </svg>
                </span>
                <span class="mt-4 font-semibold group-hover:text-primary">{card.title}</span>
                <span class="mt-1.5 text-sm text-muted-foreground">{card.description}</span>
              </a>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>
